{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/o/:id",
      "destination": "/api/order-page?id=:id"
    },
    {
      "source": "/plants/:group/:id",
      "destination": "/api/plant?group=:group&id=:id"
    },
    {
      "source": "/sitemap-plants.xml",
      "destination": "/api/plant-sitemap"
    }
  ],
  "functions": {
    "api/plant-image.js": {
      "includeFiles": "public/assets/logo.png"
    },
    "api/order-page.js": {
      "includeFiles": "tools/order-proposal/template.html"
    }
  }
}
