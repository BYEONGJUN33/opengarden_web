# 이 파일을 복사해 .env 를 만들고 토큰만 채우세요.  (.env 는 .gitignore 에 등록되어 커밋되지 않습니다)
# 토큰 발급: https://airtable.com/create/tokens
#   Scopes: data.records:read, data.records:write / Access: OpenGarden 베이스 하나만
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appzLstFHtHcQlWSu

# 카탈로그 데이터 원본 — 기본값이 코드에 있어 보통은 설정 불필요 (테이블 ID)
# AIRTABLE_TABLE_DOMESTIC=tblDMLlaBwkW1NfhU   # 국내 라인업 → 즉시 출하
# AIRTABLE_TABLE_IMPORT=tblylbZq6PLfzH1Ol     # 판매 라인업(유럽 수입) → 사전 예약

# (선택) 견적요청 테이블 이름이 다르면 지정
# AIRTABLE_QUOTE_TABLE=견적요청
